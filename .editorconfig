root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
max_line_length = 120
# Compose 的 @Composable 函数按官方约定用 PascalCase，ktlint 的 function-naming 会对它误报。
# 这是 ktlint 官方支持的开关（比在每处加 @Suppress 干净）。
ktlint_function_naming_ignore_when_annotated_with = Composable

[*.{yml,yaml,toml,json}]
indent_size = 2

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 到期提醒要发通知；🔒 不给就地申请（HyperOS 会静默驳回），只在设置页引导去系统页 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      AI 分析要发 HTTP 请求（`PRD.md` FR-PRM-01 的第三条）。
      ⚠️ 少了它，`openConnection` 抛出来的 IO 异常会被判成 `OFFLINE`——真机上看到的
      就是"网络不可用，AI 没连上"，而其实网络好好的（这一点是 P2 真机验证时才撞出来的）。
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 取景：只要相机权限，不读相册（相册走系统选图器，用不着任何权限） -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- required=false：相机可以没有，那种机器上取景屏说"这台机器没有可用的相机"，其余功能照用 -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <application
        android:name=".WheremyApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Wheremy">

        <!--
            ⚠️ 这里**故意不声明 `android:windowSoftInputMode`**（原来是 `adjustResize`）。别加回来。

            2026-10-12 真机走查抓到：本机（小米 13 / HyperOS / Android 16）+ **微信输入法 3.5.3**
            下，声明 `adjustResize` 时输入框能聚焦、系统也报 `mInputShown=true`，但**键盘画不出来**
            （`mInputMethodWindowVisibleHeight=-43`，截图里键盘完全不出现）→ 名称填不了 → 存不进去。

            对照实验（同机同版本，只改这一项，都截图核对过）：
              - 微信输入法 + adjustResize          → 键盘不显示（-43）
              - 微信输入法 + 不声明                 → 键盘正常（864）
              - 微信输入法 + adjustPan              → 键盘正常（864）
              - 搜狗输入法 + adjustResize / adjustPan / 不声明 → 都正常（885）
            即出问题的是「微信输入法 × adjustResize」这个组合。顺带一提，系统设置自己也用 adjustPan。

            为什么选"不声明"而不是 `adjustPan`：本应用是 targetSdk 36（平台强制 edge-to-edge），
            官方对 targetSdk 35+ 的建议就是**不要依赖 windowSoftInputMode 来缩放窗口**，而是在
            Compose 里消费 IME inset——所以我们按官方做法，在需要打字的可滚动屏上加了
            `Modifier.imePadding()`（`ReviewScreen.kt` / `SettingsScreen.kt`，放在 verticalScroll 之前）。
            没有 imePadding 时键盘只是"盖"在内容上，靠下的输入框会被挡住（真机验证过）。
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- WorkManager 用 Hilt 的 WorkerFactory，所以要摘掉默认初始化器 -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
